        <mxCell id="7EDd_Vg9oCwydK3HJWci-7" value="Often, the Distributor monitors data updates and relays them to the appropriate Aggregators" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;position2=0.38;flipV=0;flipH=1;" vertex="1" parent="1">
