        <mxCell id="7EDd_Vg9oCwydK3HJWci-5" value="The Aggregator is always deployed as a side-car to the PDP" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;position2=1;flipH=0;flipV=1;" vertex="1" parent="1">
