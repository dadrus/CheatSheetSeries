        <mxCell id="7EDd_Vg9oCwydK3HJWci-4" value="The PEP can reside within the microservice, in a sidecar proxy, or at the edge" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;position2=0.38;" vertex="1" parent="1">
